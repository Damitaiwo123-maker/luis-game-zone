rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.username is string && data.username.size() <= 64 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 32)) &&
             (!('coins' in data) || data.coins is number) &&
             (!('cash' in data) || data.cash is number) &&
             (!('highScore' in data) || data.highScore is number) &&
             (!('totalGamesPlayed' in data) || data.totalGamesPlayed is number) &&
             (!('totalWins' in data) || data.totalWins is number) &&
             (!('unlockedWeapons' in data) || (data.unlockedWeapons is list && data.unlockedWeapons.size() <= 30));
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'username', 'gameId', 'score']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() <= 64 &&
             data.gameId is string && data.gameId.size() <= 64 &&
             data.score is number && data.score >= 0 &&
             (!('kills' in data) || data.kills is number) &&
             (!('accuracy' in data) || data.accuracy is number);
    }

    // Test connection check
    match /test/connection {
      allow read: if true;
    }

    // User profiles & persistent records
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Global High Score & Leaderboard
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isSignedIn() && request.auth.uid == incoming().userId && isValidLeaderboardEntry(incoming());
      allow update: if isValidId(entryId) && isSignedIn() && request.auth.uid == existing().userId && request.auth.uid == incoming().userId && isValidLeaderboardEntry(incoming());
      allow delete: if isValidId(entryId) && isSignedIn() && request.auth.uid == existing().userId;
    }
  }
}
